{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile storing account information",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user identifier matching auth UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "Creator display name",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was last updated"
        }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "AuditReport": {
      "title": "AuditReport",
      "description": "Video policy audit report document",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID who initiated the audit",
          "maxLength": 128
        },
        "videoTitle": {
          "type": "string",
          "description": "Title of the audited video",
          "maxLength": 200
        },
        "overallRiskScore": {
          "type": "number",
          "description": "Risk score from 0 to 100"
        },
        "safetyGrade": {
          "type": "string",
          "description": "Safety verdict grade",
          "enum": ["SAFE_TO_UPLOAD", "MONETIZATION_AT_RISK", "HIGH_STRIKE_RISK"]
        },
        "strictnessMode": {
          "type": "string",
          "description": "Audit policy strictness level",
          "enum": ["STANDARD", "PARANOID_ZERO_RISK"]
        },
        "totalIssuesCount": {
          "type": "number",
          "description": "Total detected policy issues"
        },
        "summaryVerdictEn": {
          "type": "string",
          "description": "Audit summary verdict in English",
          "maxLength": 1500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of update"
        }
      },
      "required": ["userId", "videoTitle", "overallRiskScore", "safetyGrade", "strictnessMode", "totalIssuesCount", "summaryVerdictEn", "createdAt", "updatedAt"]
    },
    "SavedAppeal": {
      "title": "SavedAppeal",
      "description": "Generated or customized YouTube strike appeal",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Author UID who created the appeal",
          "maxLength": 128
        },
        "videoTitle": {
          "type": "string",
          "description": "Audited video title",
          "maxLength": 200
        },
        "policyType": {
          "type": "string",
          "description": "Type of YouTube policy strike being appealed",
          "maxLength": 100
        },
        "appealLetter": {
          "type": "string",
          "description": "Full formal appeal text",
          "maxLength": 10000
        },
        "status": {
          "type": "string",
          "description": "Status of the appeal draft",
          "enum": ["draft", "submitted", "approved", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modified timestamp"
        }
      },
      "required": ["userId", "videoTitle", "policyType", "appealLetter", "status", "createdAt", "updatedAt"]
    },
    "TrackedChannel": {
      "title": "TrackedChannel",
      "description": "User tracked YouTube channel with exact views, 24h/7d analytics and strike safety",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID who owns this tracked channel",
          "maxLength": 128
        },
        "userEmail": {
          "type": "string",
          "description": "Owner email address",
          "maxLength": 256
        },
        "channelId": {
          "type": "string",
          "description": "YouTube Channel ID or custom identifier",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Channel display name",
          "maxLength": 200
        },
        "handle": {
          "type": "string",
          "description": "Channel handle starting with @",
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "description": "Canonical channel URL",
          "maxLength": 500
        },
        "avatar": {
          "type": "string",
          "description": "Channel avatar image URL",
          "maxLength": 1000
        },
        "bannerUrl": {
          "type": "string",
          "description": "Channel banner image URL",
          "maxLength": 1000
        },
        "subscribers": {
          "type": "number",
          "description": "Total subscriber count"
        },
        "subscribersFormatted": {
          "type": "string",
          "description": "Formatted subscriber string e.g. 1.2M",
          "maxLength": 50
        },
        "totalViews": {
          "type": "number",
          "description": "Lifetime views across channel"
        },
        "totalVideos": {
          "type": "number",
          "description": "Total video count"
        },
        "isGoogleConnected": {
          "type": "boolean",
          "description": "Whether channel was connected via official Google Login"
        },
        "videos": {
          "type": "array",
          "description": "List of videos with authentic views, likes, 24h & 7d deltas",
          "items": {
            "type": "object"
          }
        },
        "snapshots": {
          "type": "array",
          "description": "Historical snapshots for calculating real 24h / 7d trends",
          "items": {
            "type": "object"
          }
        },
        "lastSyncedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when channel was last synced"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId", "channelId", "title", "handle", "url", "createdAt", "updatedAt"]
    },
    "ReviewItem": {
      "title": "ReviewItem",
      "description": "User review with star rating, comments, likes/dislikes and replies",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Author UID who wrote the review",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "description": "Name of the reviewer",
          "maxLength": 100
        },
        "userEmail": {
          "type": "string",
          "description": "Email of reviewer",
          "maxLength": 256
        },
        "userAvatar": {
          "type": "string",
          "description": "Avatar of reviewer",
          "maxLength": 1000
        },
        "rating": {
          "type": "number",
          "description": "Star rating from 1 to 5"
        },
        "comment": {
          "type": "string",
          "description": "Review text content",
          "maxLength": 2000
        },
        "likesCount": {
          "type": "number",
          "description": "Count of likes received"
        },
        "dislikesCount": {
          "type": "number",
          "description": "Count of dislikes received"
        },
        "likedBy": {
          "type": "array",
          "description": "User IDs who liked this review",
          "items": {
            "type": "string"
          }
        },
        "dislikedBy": {
          "type": "array",
          "description": "User IDs who disliked this review",
          "items": {
            "type": "string"
          }
        },
        "replies": {
          "type": "array",
          "description": "Threaded replies to this review",
          "items": {
            "type": "object"
          }
        },
        "isEdited": {
          "type": "boolean",
          "description": "Whether review was modified"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId", "userName", "rating", "comment", "likesCount", "dislikesCount", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection isolated per user"
    },
    "/audit_reports/{reportId}": {
      "schema": "AuditReport",
      "description": "Saved video audits owned by creators"
    },
    "/saved_appeals/{appealId}": {
      "schema": "SavedAppeal",
      "description": "Saved strike appeals authored by creators"
    },
    "/tracked_channels/{channelId}": {
      "schema": "TrackedChannel",
      "description": "User YouTube tracked channel with real views and 24h/7d analytics strictly isolated per user"
    },
    "/reviews/{reviewId}": {
      "schema": "ReviewItem",
      "description": "Public community reviews with likes, dislikes, and community replies"
    }
  }
}
